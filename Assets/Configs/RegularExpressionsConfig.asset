  - GroupName: describe_filters
    Patterns:
    - "(?:\u0440\u0430\u0441\u0441\u043A\u0430\u0436\u0438|\u0440\u0430\u0441\u0441\u043A\u0430\u0436\u0438\u0442\u0435|\u043E\u0431\u044A\u044F\u0441\u043D\u0438|\u043E\u0431\u044A\u044F\u0441\u043D\u0438\u0442\u0435|\u043F\u043E\u0432\u0435\u0434\u0430\u0439|\u043F\u043E\u0432\u0435\u0434\u0430\u0439\u0442\u0435|\u043F\u043E\u043A\u0430\u0436\u0438|\u043F\u043E\u043A\u0430\u0436\u0438\u0442\u0435|\u043E\u043F\u0438\u0448\u0438|\u043E\u043F\u0438\u0448\u0438\u0442\u0435|\u0447\u0442\u043E\\s+\u0442\u0430\u043A\u043E\u0435|\u0447\u0442\u043E\\s+\u0442\u0430\u043A\u0438\u0435)\\s+(?:\u043C\u043D\u0435\\s+)?(?:\u043E\\s+)?(?:\u043D\u0430\u0441\u0442\u043E\u043B\u044C\u043D\u044B\u0445\\s+\u0438\u0433\u0440\u0430\u0445|\u043D\u0430\u0441\u0442\u043E\u043B\u044C\u043D\u044B\u0435\\s+\u0438\u0433\u0440\u044B|\u043D\u0430\u0441\u0442\u043E\u043B\u043A\u0430\u0445|\u0438\u0433\u0440\u0430\u0445|\u044D\u0442\u0438\u0445\\s+\u0438\u0433\u0440\u0430\u0445|\u0432\u0441\u0435\u0445\\s+\u043F\u0430\u0440\u0430\u043C\u0435\u0442\u0440\u0430\u0445|\u043F\u0430\u0440\u0430\u043C\u0435\u0442\u0440\u0430\u0445\\s+\u0444\u0438\u043B\u044C\u0442\u0440\u0430|\u0444\u0438\u043B\u044C\u0442\u0440\u0430\u0445|\u0444\u0438\u043B\u044C\u0442\u0440\u0430\u0446\u0438\u0438)"
  _stringsForCombo:
  - GroupName: name_price
    Patterns:
    - "(?:\u044F\\s+)?(?:\u0445\u043E\u0447\u0443|\u0438\u0449\u0443|\u043D\u0443\u0436\u043D[\u0430\u043E]|\u043F\u043E\u043A\u0430\u0436\u0438|\u043D\u0430\u0439\u0434\u0438|\u043F\u043E\u0434\u0431\u0435\u0440\u0438)\\s+(?:[\"\xAB']?)([\u0410-\u042F\u0430-\u044F\u0401\u0451A-Z][\u0410-\u042F\u0430-\u044F\u0401\u0451A-Za-z\\s\\-&]+?)(?:[\"\xBB']?)\\s+\u0434\u0435\u0448\u0435\u0432\u043B\u0435\\s+(\\d+)\\s*(?:\u0440\u0443\u0431\u043B[\u0435\u0439\u044F]|\u0440\\.?|\u0440\u0443\u0431|\u20BD)?"
  - GroupName: like_num_of_players
    Patterns:
    - "\u043C\u043D\u0435\\s+\u043D\u0440\u0430\u0432\u0438\u0442\u0441\u044F\\s+([^,\\.]+?)\\s*,\\s*\u0430\\s+\u0435\u0441\u0442\u044C\\s+\u043B\u0438\\s+\u0447\u0442\u043E-\u0442\u043E(?:\\s+\u043F\u043E\u0445\u043E\u0436\u0435\u0435)?\\s+\u043D\u0430\\s+(\u0434\u0432\u043E\u0438\u0445|(\\d+)\\s*\u0445?)(?:\\s*[\\.!?,]?\\s*$)"
  - GroupName: name_tag
    Patterns:
    - "\u0443\u0441\u0442\u0430\u043B\\s+\u043E\u0442\\s+(.+?)\\s*,\\s*\u0445\u043E\u0447\u0443.*?\u0438\u0437\\s+([^\\.\\s]+)"
  - GroupName: likeTag
    Patterns:
    - "(?:\u043C\u043D\u0435\\s+)?(?:\u043D\u0440\u0430\u0432\u044F\u0442\u0441\u044F|\u043D\u0440\u0430\u0432\u0438\u0442\u0441\u044F|\u043B\u044E\u0431\u043B\u044E|\u043F\u0440\u0435\u0434\u043F\u043E\u0447\u0438\u0442\u0430\u044E)\\s+(?:[\"\xAB']?)([\u0410-\u042F\u0430-\u044F\u0401\u0451A-Z][\u0410-\u042F\u0430-\u044F\u0401\u0451A-Za-z\\s\\-&]+?)(?:[\"\xBB']?)\\s+(?:\u0438\u0433\u0440\u044B|\u0438\u0433\u0440).*?(?:\u0447\u0442\u043E\\s+\u043C\u043D\u0435\\s+\u0435\u0449\u0435|\u0447\u0442\u043E\\s+\u043F\u043E\u0441\u043E\u0432\u0435\u0442\u0443\u0435\u0448\u044C|\u0447\u0442\u043E\\s+\u043F\u043E\u0440\u0435\u043A\u043E\u043C\u0435\u043D\u0434\u0443\u0435\u0448\u044C|\u0447\u0442\u043E\\s+\u043C\u043E\u0436\u0435\u0442\\s+\u043F\u043E\u043D\u0440\u0430\u0432\u0438\u0442\u044C\u0441\u044F|\u0447\u0442\u043E\\s+\u0435\u0449\u0435)"
  - GroupName: dislikeTag
    Patterns:
    - "\u0443\u0441\u0442\u0430\u043B\\s+\u043E\u0442\\s+([^\\s\\.]+)(?:\\s+\u0438\u0433\u0440)?"
  _regexForRecommendations:
  - GroupName: like_game
  - GroupName: dislike_game
  - GroupName: show_recommendations
  - GroupName: already_buy
  _regexForSearch:
  - GroupName: price_filter
  - GroupName: num_of_players_filter
  - GroupName: tags_filter
  - GroupName: time_filter
  - GroupName: name_filter
  _regexForHistory:
  - GroupName: undo
  - GroupName: undo_all
  _regexForGeneral:
